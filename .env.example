PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Set to false and provide JWT_SECRET in production.
AUTH_DISABLED=true
JWT_SECRET=

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=dms

SIGNED_URL_TTL_SECONDS=900
MAX_UPLOAD_BYTES=104857600

# Demo tenant (see sql/seed.sql) — referenced by name, not stored in SQL
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Optional live integration tests
# RUN_INTEGRATION=true
# IT_MINIO_ENDPOINT=http://127.0.0.1:9000
# IT_MINIO_BUCKET=documents
# IT_MINIO_ACCESS_KEY=minioadmin
# IT_MINIO_SECRET_KEY=minioadmin
