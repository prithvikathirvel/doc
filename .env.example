PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# ── Web UI authentication (Keycloak through the User Service) ────────────────
# The browser signs in at POST /api/auth/login; tokens are kept in httpOnly
# cookies and verified against the realm's published keys (JWKS).
DMS_APP_ID=DMS
USER_MGT_BASE_URL=https://apidev.sifymodernization.digital/user-mgt
KEYCLOAK_BASE_URL=http://1.6.37.35/keycloak
KEYCLOAK_REALM=DMS
KEYCLOAK_CLIENT_ID=DMS
KEYCLOAK_CLIENT_SECRET=
# Set true to reject tokens whose issuer is not exactly <baseUrl>/realms/<realm>
KEYCLOAK_STRICT_ISSUER=false

# Bootstrap platform administrators (comma separated). The flag is persisted to
# dms_users the first time each address signs in.
# DMS_PLATFORM_ADMINS=ops@yourcompany.com,dev.lead@yourcompany.com

# Refresh-cookie lifetime and login throttling
# DMS_REFRESH_COOKIE_MAX_AGE_SECONDS=604800
# DMS_LOGIN_RATE_WINDOW_SECONDS=300
# DMS_LOGIN_RATE_MAX=10
# Force the Secure cookie flag ('true'/'false'); unset auto-detects per request
# DMS_COOKIE_SECURE=auto

# ── Machine clients ─────────────────────────────────────────────────────────
# API keys are created by platform administrators in the console (x-api-key
# header) — no environment variable needed.
#
# Legacy trusted-header mode (x-user-id / x-tenant-id / x-roles) for existing
# API integrations. Only enable behind a gateway or on a trusted network.
AUTH_DISABLED=false

# HMAC token secret — used ONLY for local development and the preview API
# (scripts/dev-preview-api.ts sets it automatically). Never in production.
JWT_SECRET=

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=dms

SIGNED_URL_TTL_SECONDS=900
MAX_UPLOAD_BYTES=104857600

# Demo tenant (see sql/seed.sql) — referenced by name, not stored in SQL
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Optional live integration tests
# RUN_INTEGRATION=true
# IT_MINIO_ENDPOINT=http://127.0.0.1:9000
# IT_MINIO_BUCKET=documents
# IT_MINIO_ACCESS_KEY=minioadmin
# IT_MINIO_SECRET_KEY=minioadmin
