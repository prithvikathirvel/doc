PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Start local development with the legacy header session. Set AUTH_MODE=keycloak
# and AUTH_ALLOW_DEV_HEADERS=false in staging/production.
AUTH_MODE=headers
AUTH_DISABLED=true
AUTH_ALLOW_DEV_HEADERS=true
ALLOW_PUBLIC_SIGNUP=true
JWT_SECRET=

# User Management Service
USER_MGT_BASE_URL=https://apidev.sifymodernization.digital/user-mgt
DMS_APP_ID=DMS
# The Keycloak client id that mints user tokens. In the Sify deployment the
# access token's `azp` is "DMS", so this is "DMS" (not "dms-web"). It is also
# the client used for server-side token refresh and the service-account token.
DMS_APP_CLIENT_ID=DMS
DMS_APP_CLIENT_SECRET=replace-with-the-server-only-client-secret
DMS_WEB_ORIGIN=http://localhost:3000
# Comma-separated browser origins allowed to call the DMS API.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# External Swagger/API path. Use /dms/api when Nginx publishes this service under /dms.
PUBLIC_API_PATH=/api

# Keycloak token validation / server-side refresh
# IMPORTANT: the realm name is case-sensitive in Keycloak URLs. The Sify realm
# is "DMS" (uppercase) — the access token's `iss` is .../realms/DMS. Keep the
# case consistent across KEYCLOAK_REALM, KEYCLOAK_ISSUER and KEYCLOAK_JWKS_URI.
KEYCLOAK_BASE_URL=http://1.6.37.35/keycloak
KEYCLOAK_REALM=DMS
KEYCLOAK_JWKS_URI=http://1.6.37.35/keycloak/realms/DMS/protocol/openid-connect/certs
KEYCLOAK_ISSUER=http://1.6.37.35/keycloak/realms/DMS
KEYCLOAK_CLOCK_TOLERANCE=15
# Comma-separated Keycloak client ids accepted in the token's azp/aud claim,
# in ADDITION to DMS_APP_CLIENT_ID. List the client id of each tenant service
# that integrates with the DMS API so its validly-signed tokens are accepted.
# Example: KEYCLOAK_ALLOWED_CLIENT_IDS=tenant-acme-service,tenant-globex-api
KEYCLOAK_ALLOWED_CLIENT_IDS=

# Authoritative role resolution. Roles are NEVER trusted from the access token;
# they are resolved per request from the User Management Service (app role,
# incl. platform_admin) and the DMS tenant_members table (tenant role), cached
# briefly per user. See docs/SECURE_AUTHORIZATION.md.
ROLE_RESOLVER_ENABLED=true
ROLE_CACHE_TTL_SECONDS=60

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=dms

SIGNED_URL_TTL_SECONDS=900
MAX_UPLOAD_BYTES=104857600

# Demo tenant (see sql/seed.sql) — referenced by name, not stored in SQL
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Optional live integration tests
# RUN_INTEGRATION=true
# IT_MINIO_ENDPOINT=http://127.0.0.1:9000
# IT_MINIO_BUCKET=documents
# IT_MINIO_ACCESS_KEY=minioadmin
# IT_MINIO_SECRET_KEY=minioadmin
