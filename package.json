{
  "name": "document-service",
  "version": "1.0.0",
  "description": "cloud agnostic document service",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "serve:gcf": "functions-framework --source=dist/controller/subscriptionControllerGcf.js --target=addProduct",
    "serve:express-dev": "nodemon --exec ts-node src/index.ts", 
    "serve:express": "node dist/index.js",
    "dev": "node --loader ts-node/esm src/index.ts",
