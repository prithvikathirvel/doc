# Server-side Next rewrite target for local development.
DMS_API_URL=http://127.0.0.1:3001
# In a deployment where the UI host does not proxy POST /api requests, set this
# to the browser-reachable DMS API origin (without the /api suffix).
NEXT_PUBLIC_DMS_API_BASE_URL=https://apidev.sifymodernization.digital/dms
NEXT_PUBLIC_APP_NAME=DMS
NEXT_PUBLIC_DMS_APP_ID=DMS
NEXT_PUBLIC_AUTH_MODE=keycloak
NEXT_PUBLIC_ALLOW_PUBLIC_SIGNUP=true

# Public User Service endpoints used by the login and signup forms.
NEXT_PUBLIC_USER_MGT_BASE_URL=https://apidev.sifymodernization.digital/user-mgt

# These URLs must be reachable from the browser and allow the DMS origin in CORS.
# Leave NEXT_PUBLIC_KEYCLOAK_TOKEN_URL empty to use the DMS refresh proxy instead.
NEXT_PUBLIC_KEYCLOAK_BASE_URL=
NEXT_PUBLIC_KEYCLOAK_TOKEN_URL=
NEXT_PUBLIC_KEYCLOAK_REALM=dms
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=dms-web
