# Where the DMS API is reachable from the Next.js server (used by the /api rewrite).
DMS_API_URL=http://127.0.0.1:3001

# Public app name shown in the UI.
NEXT_PUBLIC_APP_NAME=DMS

# Deployment prefix. Set this to the path the app is served under, WITHOUT a
# trailing slash. It drives next.config.ts `basePath` AND is read by the API
# client (lib/basePath.ts) so every /api call and user-facing URL includes it.
#
#   root deployment (dev):  leave unset  -> calls go to /api/...
#   served under /dms:      NEXT_PUBLIC_BASE_PATH=/dms  -> calls go to /dms/api/...
#
# Without this, API calls resolve to /api/... (no prefix) and hit the edge/nginx
# instead of the proxy rewrite, returning 405.
# NEXT_PUBLIC_BASE_PATH=/dms
